# Local Docker quick start. Copy to .env; keep the real file out of Git.
APPROVAL_MCP_PUBLIC_URL=http://localhost:43127
APPROVAL_MCP_DATA_DIR=/data
# Defaults to APPROVAL_MCP_DATA_DIR/plugins; keep it on persistent storage.
# APPROVAL_MCP_PLUGINS_DIR=/data/plugins
# Generate once: openssl rand -base64 32
# Keep the ORIGINAL key for legacy migration and automatic startup unlock.
# To require passkey unlock, first enroll/test a storage passkey in System,
# save its recovery key, then remove this variable (or leave it empty).
APPROVAL_MCP_MASTER_KEY=replace_with_a_generated_base64_key
# Locked-start push needs delivery credentials outside the main vault.
# Set false to remove that copy and open /unlock manually instead.
# APPROVAL_MCP_UNLOCK_NOTIFICATIONS=false
